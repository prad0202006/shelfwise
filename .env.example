SHELFWISE_ENV=development
SHELFWISE_SECRET_KEY=replace-with-a-private-random-secret
# Optional PostgreSQL URL for production (for example, a Neon connection string).
# Leave blank to use the local books.db SQLite database.
DATABASE_URL=
SHELFWISE_COOKIE_SECURE=0

# Optional email delivery. Keep real values in the ignored .env file.
SHELFWISE_ADMIN_EMAIL=
SHELFWISE_SMTP_HOST=
SHELFWISE_SMTP_PORT=587
SHELFWISE_SMTP_USERNAME=
SHELFWISE_SMTP_PASSWORD=
SHELFWISE_SMTP_FROM=